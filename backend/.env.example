# chatgpt_plan: uses your ChatGPT plan via Sign in with ChatGPT (sign in from the web UI).
# openai_api: uses an OpenAI API key instead.
LLM_PROVIDER=chatgpt_plan
# Required for chatgpt_plan: a model available to your ChatGPT account.
CHATGPT_MODEL=
# Owner-only directory for OAuth credentials. Never commit it.
CHATGPT_AUTH_DIR=./.chatgpt-auth
# The OAuth callback is http://127.0.0.1:<port>/auth/callback; the backend must be reachable there.
OAUTH_CALLBACK_PORT=1455
FRONTEND_URL=http://127.0.0.1:3000

OPENAI_API_KEY=
# Development model (mini-class). Required for openai_api.
OPENAI_MODEL=
# Leave empty (LLM_TEMPERATURE=) for models that reject temperature.
LLM_TEMPERATURE=0
# Higher temperature for task generation so a set's questions differ (openai_api only).
LLM_TASK_TEMPERATURE=0.9
LLM_TIMEOUT_S=30
# USD per 1M tokens for OPENAI_MODEL, used for cost reporting.
PRICE_INPUT_PER_MTOK=0
PRICE_OUTPUT_PER_MTOK=0
DATABASE_URL=sqlite:///./tutor.db
